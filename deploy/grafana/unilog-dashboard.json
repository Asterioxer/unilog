              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(unilog_log_records_parsed_total)",
          "legendFormat": "Total Records",
          "refId": "A"
